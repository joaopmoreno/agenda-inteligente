# Configuração do Lovable Cloud / Supabase
# Obtenha estas credenciais no painel do seu projeto Lovable Cloud ou Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# Configuração do Assistente de IA (Lovable AI Gateway / Edge Functions)
# Usado nas Server Functions em supabase/functions/
LOVABLE_AI_GATEWAY_URL=https://ai.lovable.dev/v1
LOVABLE_AI_GATEWAY_KEY=sua-chave-ai-gateway
